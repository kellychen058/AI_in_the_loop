# Optional LLM configuration.
# The app and test suite run 100% out-of-the-box with ZERO env vars (defaults to deterministic mock fallback).
# Per AI-usage-guildline.md, copy this file to `.env.local` manually as a human and NEVER commit real API keys.

# Supported providers: openai | gemini | anthropic | mock
LLM_PROVIDER=mock

# Optional provider API keys (only needed when using a live LLM provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
